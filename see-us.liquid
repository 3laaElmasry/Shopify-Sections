{% schema %}
{
"name": "see-us",
"settings": [
{
"type": "text",
"id": "heading",
"label": "Heading Text",
"default": "see us in action"
},
{
"type": "color",
"id": "brand_color",
"label": "Brand Gold Color",
"default": "#B1945F"
},
{
"type": "color",
"id": "bg_color",
"label": "Section Background",
"default": "#F9F8F6"
},
{
"type": "range",
"id": "desktop_width",
"label": "Section Width (Desktop)",
"min": 40,
"max": 100,
"step": 5,
"unit": "%",
"default": 70
}
],
"blocks": [
{
"type": "review_video",
"name": "Review Video",
"settings": [
{
"type": "video",
"id": "video",
"label": "Select Review Video"
},
{
"type": "product",
"id": "product",
"label": "Select Linked Product"
}
]
}
],
"presets": [
{
"name": "see-us"
}
]
}
{% endschema %}

<style>
    @import url('https://fonts.cdnfonts.com/css/baskerville-2');

    .mavida-v3-wrapper {
        background-color: {
                {
                section.settings.bg_color
            }
        }

        ;
        padding: 60px 0;
        overflow: hidden;
        width: 100%;
        position: relative;
    }

    .mavida-v3-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        width: {
                {
                section.settings.desktop_width
            }
        }

        %;
        max-width: 100%;
        margin: 0 auto;
        padding: 0;
        gap: 40px;
        position: relative;
        transition: width 0.3s ease;
    }

    .mavida-v3-header {
        width: 100%;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .mavida-v3-title {
        color: {
                {
                section.settings.brand_color
            }
        }

        ;
        letter-spacing: 1px;
        margin: 0;
        font-family: "Baskerville Regular",
        "Baskerville",
        "Baskerville Old Face",
        "Hoefler Text",
        Garamond,
        serif;
        font-size: 48px;
        font-weight: 400;
        text-transform: lowercase;
    }

    .mavida-v3-slider-wrapper {
        position: relative;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .mavida-v3-viewport {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        position: relative;
        padding: 20px 0;
        direction: ltr;
        display: flex;
        scroll-behavior: smooth;
        scroll-snap-type: x mandatory;
    }

    .mavida-v3-viewport::-webkit-scrollbar {
        display: block;
        height: 4px;
    }

    .mavida-v3-viewport::-webkit-scrollbar-track {
        background: rgba(0, 0, 0, 0.05);
        border-radius: 10px;
    }

    .mavida-v3-viewport::-webkit-scrollbar-thumb {
        background: {
                {
                section.settings.brand_color
            }
        }

        ;
        border-radius: 10px;
        cursor: pointer;
    }

    .mavida-v3-viewport::-webkit-scrollbar-thumb:hover {
        background: #000000;
    }

    .mavida-v3-track {
        display: flex;
        gap: 25px;
        align-items: center;
        width: max-content;
        margin: 0 auto;
        padding: 0 50px 15px 50px;
    }

    .mavida-v3-card {
        flex: 0 0 264px;
        width: 264px;
        height: 546px;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        background: #000;
        border: 1px solid rgba(0, 0, 0, 0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        scroll-snap-align: center;
        position: relative;
        transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.6s ease;
    }

    .mavida-v3-card video {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
    }

    .mavida-video-play-btn {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) scale(0.9);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        opacity: 0;
        transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
        z-index: 12;
    }

    .mavida-v3-card:hover .mavida-video-play-btn {
        opacity: 0.6;
        transform: translate(-50%, -50%) scale(1);
    }

    .mavida-v3-card:hover .mavida-video-play-btn:hover {
        opacity: 0.9;
        background: #000000;
        border-color: #ffffff;
    }

    .mavida-video-play-btn svg {
        width: 16px;
        height: 16px;
        fill: #ffffff;
    }

    .mavida-video-mute-btn {
        position: absolute;
        top: 15px;
        left: 15px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        opacity: 0.5;
        transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
        z-index: 13;
    }

    .mavida-v3-card:hover .mavida-video-mute-btn {
        opacity: 0.6;
    }

    .mavida-v3-card:hover .mavida-video-mute-btn:hover {
        opacity: 0.9;
        background: #000000;
        border-color: #ffffff;
    }

    .mavida-video-mute-btn svg {
        width: 14px;
        height: 14px;
        fill: #ffffff;
    }

    .mavida-product-overlay-card {
        position: absolute;
        bottom: 20px;
        left: 10%;
        width: 80%;
        height: 20%;
        background: rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        display: flex;
        overflow: hidden;
        z-index: 15;
        text-decoration: none;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
        transition: transform 0.3s ease, background-color 0.3s ease;
    }

    .mavida-product-overlay-card:hover {
        transform: scale(1.03);
        background: rgba(255, 255, 255, 0.4);
    }

    .mavida-pcard-img-side {
        width: 40%;
        height: 100%;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.5);
    }

    .mavida-pcard-img-side img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .mavida-pcard-info-side {
        width: 60%;
        height: 100%;
        padding: 8px 10px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 2px;
        text-align: left;
        box-sizing: border-box;
    }

    .mavida-pcard-title {
        margin: 0;
        font-size: 13px;
        font-weight: 600;
        color: #000000;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mavida-pcard-stars {
        display: flex;
        gap: 1px;
        line-height: 1;
    }

    .mavida-pcard-stars svg {
        width: 11px;
        height: 11px;
        fill: #FFD700;
    }

    .mavida-pcard-price {
        font-size: 12px;
        font-weight: 700;
        color: #000000;
        margin: 0;
    }

    @media (max-width: 767px) {
        .mavida-v3-wrapper {
            padding: 40px 0;
        }

        .mavida-v3-container {
            width: 100% !important;
            gap: 25px;
        }

        .mavida-v3-viewport::-webkit-scrollbar {
            display: none;
        }

        .mavida-v3-viewport {
            padding-left: 0;
            padding-right: 0;
            scrollbar-width: none;
        }

        .mavida-v3-track {
            margin: 0;
            gap: 15px;
            padding: 0 20px 0 20px;
        }

        .mavida-v3-card {
            flex: 0 0 198px;
            width: 198px;
            height: 403px;
        }

        .mavida-video-play-btn {
            opacity: 0.6;
            width: 36px;
            height: 36px;
        }

        .mavida-video-mute-btn {
            opacity: 0.6;
            top: 12px;
            left: 12px;
        }

        .mavida-v3-title {
            font-size: 24px;
            letter-spacing: 1.5px;
        }

        .mavida-product-overlay-card {
            bottom: 15px;
            height: 22%;
        }

        .mavida-pcard-info-side {
            padding: 6px 8px;
        }

        .mavida-pcard-title {
            font-size: 11px;
        }

        .mavida-pcard-price {
            font-size: 11px;
        }
    }
</style>

<div class="mavida-v3-wrapper" id="mavida-section-{{ section.id }}">
    <div class="mavida-v3-container">

        <div class="mavida-v3-header">
            <h2 class="mavida-v3-title">{{ section.settings.heading }}</h2>
        </div>

        <div class="mavida-v3-slider-wrapper">
            <div class="mavida-v3-viewport">
                <div class="mavida-v3-track">
                    {% for block in section.blocks %}
                    <div class="mavida-v3-card" {{ block.shopify_attributes }}>
                        {% if block.settings.video != blank %}

                        <button class="mavida-video-mute-btn" aria-label="Unmute Video">
                            <svg class="icon-muted" viewBox="0 0 24 24">
                                <path
                                    d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77zM3 9v6h4l5 5V4L7 9H3z" />
                            </svg>
                            <svg class="icon-audio" viewBox="0 0 24 24" style="display:none;">
                                <path
                                    d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z" />
                            </svg>
                        </button>

                        <button class="mavida-video-play-btn" aria-label="Pause Video">
                            <svg class="icon-pause" viewBox="0 0 24 24">
                                <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                            </svg>
                            <svg class="icon-play" viewBox="0 0 24 24" style="display:none; margin-left: 2px;">
                                <path d="M8 5v14l11-7z" />
                            </svg>
                        </button>

                        {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true,
                        controls: false, loading: "lazy" }}

                        {% assign associated_product = block.settings.product %}
                        {% if associated_product != blank %}
                        <a href="{{ associated_product.url }}" class="mavida-product-overlay-card">
                            <div class="mavida-pcard-img-side">
                                {% if associated_product.featured_image != blank %}
                                <img src="{{ associated_product.featured_image | img_url: '200x200', crop: 'center' }}"
                                    alt="{{ associated_product.title | escape }}" loading="lazy">
                                {% else %}
                                {{ 'product-1' | placeholder_svg_tag }}
                                {% endif %}
                            </div>
                            <div class="mavida-pcard-info-side">
                                <h4 class="mavida-pcard-title">{{ associated_product.title }}</h4>
                                <div class="mavida-pcard-stars">
                                    {% for i in (1..5) %}
                                    <svg viewBox="0 0 24 24">
                                        <path
                                            d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                                    </svg>
                                    {% endfor %}
                                </div>
                                <p class="mavida-pcard-price">{{ associated_product.price | money }}</p>
                            </div>
                        </a>
                        {% endif %}

                        {% else %}
                        <div style="color: #666; font-size: 12px; padding: 20px; text-align: center;">قم باختيار فيديو
                            من لوحة التحكم</div>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const section = document.getElementById("mavida-section-{{ section.id }}");
        if (!section) return;

        const viewport = section.querySelector(".mavida-v3-viewport");
        const cards = section.querySelectorAll(".mavida-v3-card");

        cards.forEach(card => {
            const video = card.querySelector("video");
            const playBtn = card.querySelector(".mavida-video-play-btn");
            const muteBtn = card.querySelector(".mavida-video-mute-btn");
            if (!video || !playBtn || !muteBtn) return;

            const iconPause = playBtn.querySelector(".icon-pause");
            const iconPlay = playBtn.querySelector(".icon-play");
            const iconMuted = muteBtn.querySelector(".icon-muted");
            const iconAudio = muteBtn.querySelector(".icon-audio");

            playBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                if (video.paused) {
                    video.play();
                    iconPause.style.display = "block";
                    iconPlay.style.display = "none";
                } else {
                    video.pause();
                    iconPause.style.display = "none";
                    iconPlay.style.display = "block";
                }
            });

            muteBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                if (video.muted) {
                    video.muted = false;
                    iconMuted.style.display = "none";
                    iconAudio.style.display = "block";
                } else {
                    video.muted = true;
                    iconMuted.style.display = "block";
                    iconAudio.style.display = "none";
                }
            });
        });

        if (viewport) {
            let isScrolling;
            viewport.addEventListener("scroll", function () {
                window.clearTimeout(isScrolling);
                isScrolling = setTimeout(function () {
                    const viewportCenter = viewport.getBoundingClientRect().left + (viewport.offsetWidth / 2);
                    let closestCard = null;
                    let minDistance = Infinity;

                    cards.forEach(card => {
                        const cardCenter = card.getBoundingClientRect().left + (card.offsetWidth / 2);
                        const distance = Math.abs(viewportCenter - cardCenter);
                        if (distance < minDistance) {
                            minDistance = distance;
                            closestCard = card;
                        }
                    });

                    if (closestCard) {
                        const scrollLeft = closestCard.offsetLeft - (viewport.offsetWidth / 2) + (closestCard.offsetWidth / 2);
                        viewport.scrollTo({
                            left: scrollLeft,
                            behavior: "smooth"
                        });
                    }
                }, 150);
            }, { passive: true });
        }
    });
</script>
